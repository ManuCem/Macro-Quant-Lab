    {
      "parameters": {
        "jsCode": "// refuse to continue if the script failed or printed nothing (stops the LLM inventing a signal)\nconst r = $input.first().json;\nif (r.code !== 0 || !r.stdout || !r.stdout.trim()) throw new Error('Script failed or returned no output');\n// cap size: limits LLM cost and prompt-stuffing; stderr is never forwarded\nreturn [{ json: { stdout: r.stdout.slice(0, 4000) } }];"
      },
